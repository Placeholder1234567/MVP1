# Local development. Copy to .env and adjust. Never put real client data in a dev database.
# Production values live in Secret Manager (infrastructure.md); see CLAUDE.md for the full list.
DATABASE_URL=postgres://guad:guad@localhost:5433/guad

# Sign-in through the local Auth emulator (npm run dev:auth). demo-* projects never touch Google.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GOOGLE_CLOUD_PROJECT=demo-guad
PUBLIC_FIREBASE_PROJECT_ID=demo-guad
PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
