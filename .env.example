# Local development. Copy to .env and adjust. Never put real client data in a dev database.
# Production values live in Secret Manager (infrastructure.md); see CLAUDE.md for the full list.
DATABASE_URL=postgres://guad:guad@localhost:5433/guad

# In-process jobs and recurring maintenance; production uses cloud-tasks.
JOBS_DRIVER=local
# Mailpit captures local email at http://localhost:8025.
SMTP_URL=smtp://localhost:1025
APP_URL=http://localhost:5173
# Optional BUILD-TIME canonical origin (SvelteKit 3); e.g. http://127.0.0.1:4173 for an HTTP preview.
# Production should use the public HTTPS origin. This replaces runtime ORIGIN.
APP_ORIGIN=

# Delivery drivers (src/lib/server/messaging). Locally push and SMS are logged
# by notification ID only. Production: PUSH_DRIVER=fcm, EMAIL_DRIVER=ses,
# SMS_DRIVER=aws, with AWS_REGION, AWS_ROLE_ARN (workload identity federation,
# no AWS keys), SES_FROM_ADDRESS, SES_CONFIGURATION_SET, SMS_ORIGINATION_IDENTITY,
# SMS_CONFIGURATION_SET, and the SNS topics the worker accepts events from:
# SES_EVENTS_TOPIC_ARN, SMS_EVENTS_TOPIC_ARN.
PUSH_DRIVER=console
EMAIL_DRIVER=smtp
SMS_DRIVER=console

# Optional Lomi providers. Leave empty to use conservative local sentence sorting.
# Use the Cloud Run service account / application default credentials, never browser keys.
VERTEX_REGION=
LOMI_MODEL=
# projects/<project>/locations/<region>/recognizers/<recognizer>
STT_RECOGNIZER=
STT_MODEL=chirp_3

# Sign-in through the local Auth emulator (npm run dev:auth). demo-* projects never touch Google.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GOOGLE_CLOUD_PROJECT=demo-guad
PUBLIC_FIREBASE_PROJECT_ID=demo-guad
PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Local PowerSync (npm run db:up). The dev key signs sync tokens only while the
# Auth emulator is in use; production verifies real Identity Platform tokens.
PS_DEV_JWT_KEY=gi3XNOLkX6khPVxN4PpCoi7zVjDi9lljHRkgCTItfss
PUBLIC_POWERSYNC_URL=http://localhost:8080

# Encrypts the server copy of each device's database key (device_keys). Dev only;
# production keeps it in Secret Manager.
DEVICE_KEY_KEK=5JnVufYPg_lWSqzmUZYV7FPssgpajWjvRoSXwToT8o0
