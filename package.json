{
	"name": "guad",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run tests/unit",
		"test:unit": "vitest run tests/unit",
		"test:integration": "firebase emulators:exec --only auth --project demo-guad \"vitest run tests/integration\"",
		"lint": "eslint . && npm run check",
		"format": "prettier --write .",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"spec:lint": "node .specify/lint.js",
		"spec:rls-test": "bash .specify/tests/rls/run.sh",
		"db:setup": "node scripts/db-setup.mjs",
		"db:reset": "node scripts/db-setup.mjs --reset",
		"test:all": "vitest run",
		"dev:auth": "firebase emulators:start --only auth --project demo-guad",
		"db:seed": "tsx --env-file=.env src/lib/server/seed.ts",
		"pretest": "svelte-kit sync",
		"pretest:integration": "svelte-kit sync",
		"sync:probe": "tsx --env-file=.env scripts/sync-probe.ts",
		"sync:rules": "node scripts/sync-rules.mjs && node scripts/sync-schema.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"firebase-tools": "^15.33.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Guad: charting, scheduling and AI coverage for IDD residential care agencies",
	"engines": {
		"node": ">=22.18"
	},
	"dependencies": {
		"@google-cloud/tasks": "^7.3.0",
		"@powersync/common": "^2.3.1",
		"@powersync/web": "^2.4.2",
		"@trpc/client": "^11.19.0",
		"@trpc/server": "^11.19.0",
		"croner": "^10.0.1",
		"drizzle-orm": "^0.45.4",
		"firebase": "^13.0.0",
		"firebase-admin": "^14.5.0",
		"google-auth-library": "^11.3.0",
		"jose": "^6.2.12",
		"nodemailer": "^10.1.1",
		"pg": "^8.23.1",
		"superjson": "^2.2.6",
		"zod": "^4.6.7"
	}
}
