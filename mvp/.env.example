# Copy to your hosting provider's environment settings. Never commit real keys.
ANTHROPIC_API_KEY=
# Used by the microphone transcription endpoint (/api/transcribe).
OPENAI_API_KEY=
# Optional: override the model Lomi uses.
LOMI_MODEL=claude-sonnet-5-5
# Optional: extra hosts allowed to call /api/* (comma-separated). The serving host is always allowed.
GUAD_ALLOWED_ORIGINS=
