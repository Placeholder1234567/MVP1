{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node"],
		"lib": ["ES2023", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["playwright.config.ts", "tests/e2e/**/*.ts"]
}
